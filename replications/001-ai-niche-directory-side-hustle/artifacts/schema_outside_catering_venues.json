    {
      "@type": "FAQPage",
      "@id": "https://outside-catering-venues.example.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do you verify that a venue truly allows outside catering?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our AI enrichment pipeline cross-references each venue's rental contract policy and customer review evidence to confirm whether licensed third-party caterers, cultural caterers, or food trucks are permitted without mandatory in-house F&B minimums."
          }
        },
        {
          "@type": "Question",
          "name": "What does 'Zero Corkage / Buyout Fee' mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Many venues advertise 'outside catering allowed' but charge a $15-$35 per-person outside catering buyout fee. Listings tagged 'Zero Corkage / Buyout Fee' charge $0 extra when you bring a licensed caterer or TABC/state-certified bartender."
          }
        },
        {
          "@type": "Question",
          "name": "How can a venue upgrade to a Featured Placement ($30/mo)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Verified venue owners can upgrade any listing for $30/month to pin their venue to the top of city and filter results, display a Verified Featured badge, and receive instant SMS/email routing on incoming event quote inquiries."
          }
        }
      ]
    }
